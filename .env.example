TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=replace_with_your_api_hash

# Можно оставить пустым: при первом запуске Telethon спросит номер сам.
TELEGRAM_PHONE=
TELEGRAM_AUTH_MODE=qr

TELEGRAM_FOLDER=Поиск работы
TELEGRAM_SESSION=data/collector
DATABASE_PATH=data/vacancies.db

# Только для первой загрузки пустой базы.
INITIAL_HOURS_BACK=72
INITIAL_MAX_MESSAGES_PER_CHAT=500

# Защита от слишком большой догрузки одного канала за один цикл.
MAX_MESSAGES_PER_CHAT_PER_RUN=1000

# Один час.
POLL_INTERVAL_SECONDS=3600

# Полезно на этапе исследования. Можно выключить для уменьшения базы.
STORE_RAW_JSON=true
LOG_LEVEL=INFO
